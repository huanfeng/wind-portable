#!/usr/bin/env bash
# 激活方式（一次性）: git config core.hooksPath .githooks
set -e
ROOT="$(git rev-parse --show-toplevel)"

cd "$ROOT"

echo "[pre-commit] cargo fmt check..."
if ! cargo fmt --all -- --check 2>/dev/null; then
    echo ""
    echo "  格式检查失败，请运行: cargo fmt"
    echo ""
    exit 1
fi
echo "[pre-commit] fmt OK"

echo "[pre-commit] cargo clippy check..."
if ! cargo clippy --all-targets -- -D warnings; then
    echo ""
    echo "  clippy 检查失败，请修复上面列出的问题后再提交"
    echo ""
    exit 1
fi
echo "[pre-commit] clippy OK"
